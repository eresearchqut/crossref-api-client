{
  "name": "@eresearchqut/crossref-api-client",
  "version": "1.0.0",
  "description": "Open API Client for the Crossref REST API",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "generated/spec.json",
    "generated/spec.transformed.json",
    "scripts/crossref.overlay.yaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eresearchqut/crossref-api-client.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rimraf node_modules dist generated",
    "prebuild": "rimraf generated/typescript-fetch && node ./generateFromSchema.js",
    "build": "tsc",
    "test": "jest"
  },
  "release": {
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "type": "docs",
              "scope": "README",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            }
          ],
          "parserOpts": {
            "noteKeywords": [
              "BREAKING CHANGE",
              "BREAKING CHANGES"
            ]
          }
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@eresearchqut/jest-testcontainers": "^3.8.0",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.1.0",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "dotenv": "^16.3.1",
    "jest": "^29.7.0",
    "openapi-format": "^1.34.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.1.0",
    "semver": "^7.8.6",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.0",
    "wiremock-captain": "^4.1.3"
  }
}
